# Copy to .env and fill in. RunPod exposes HTTP ports as https://<POD_ID>-<PORT>.proxy.runpod.net
LLM_BASE_URL=https://<POD_ID>-8000.proxy.runpod.net/v1
STT_BASE_URL=https://<POD_ID>-8001.proxy.runpod.net/v1
TTS_BASE_URL=https://<POD_ID>-8880.proxy.runpod.net/v1

# Shared key for the GPU servers (pass the same value to deploy/start_gpu_servers.sh)
VLLM_API_KEY=change-me

# Only needed for provider: openai
# OPENAI_API_KEY=
